# Copy this file to .env and fill in your own values. Never commit .env.
# quarry reads .env from the directory you run it in; variables already set in your shell take priority.

# Required only for `quarry ask --backend claude` (or auto mode with a key present).
ANTHROPIC_API_KEY=your-api-key-here

# Optional overrides.
# QUARRY_MODEL=claude-opus-5-5
# QUARRY_EFFORT=medium
